      "item": [
        {
          "id": "3ca0225c-88cd-4896-8005-f6f6fd5d2d94",
          "name": "Mindbody When Users Interact with Your Public API Integration as Staff Members,",
          "request": {
            "name": "Mindbody When Users Interact with Your Public API Integration as Staff Members,",
            "description": {
              "content": "When users interact with your Public API integration as staff members, they need to get a staff user token for authentication. You can use the issue endpoint to get a staff user token, then pass the token in the headers for all of your requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "public",
                "v6",
                "usertoken",
                "issue"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "version",
                  "description": "(Required) version of the api."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ID of the site from which to pull data.",
                "key": "siteId",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
