        {
          "info": {
            "name": "Mindbody Returns a List of Enrollments. an Enrollment is a Service, Such as a",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mindbodyonline.com/public/v6/enrollment/enrollments",
            "headers": [
